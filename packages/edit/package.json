{
  "name": "@tailor-cms/ce-html-raw-edit",
  "description": "Raw HTML edit component",
  "author": "Studion <info@gostudion.com> (https://github.com/tailor-cms)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-cms/ce-html-raw.git",
    "directory": "packages/edit"
  },
  "homepage": "https://github.com/tailor-cms/ce-html-raw#readme",
  "bugs": "https://github.com/tailor-cms/ce-html-raw/issues",
  "type": "module",
  "version": "2.0.2",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm nuke:dist && vue-tsc && vite build",
    "lint": "eslint ./src",
    "lint:fix": "pnpm lint --fix",
    "nuke": "pnpm dlx del-cli dist node_modules",
    "nuke:dist": "pnpm dlx del-cli dist",
    "prepublish": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@tailor-cms/ce-html-raw-manifest": "workspace:*",
    "@tailor-cms/eslint-config": "2.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue-tsc": "^3.3.9",
    "vuetify": "^4.1.8"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailor-cms/cek-common": "2.0.3",
    "lodash-es": "^4.18.1",
    "sanitize-html": "^2.17.3",
    "vue-codemirror": "^6.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  }
}
